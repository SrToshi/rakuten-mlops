/logs/

# Artifacts
# /models/

# MLflow local store (the tracking server owns this, not Git)
mlruns/
mlflow.db

# Model artifacts downloaded from the registry at serving time
models/champion/

# Evidently reports
reports/drift/

# DVC, initialised with --no-scm (see scripts/setup_dvc.sh).
#
# That flag is what the brief asks for, and it has a consequence worth
# knowing: with --no-scm, DVC does NOT write the .gitignore files it
# normally drops beside its cache and its tracked data. Nothing here is
# automatic, so these entries are hand-written.
#
# The cache holds a full copy of every tracked file — adding the training
# images would put ~2.4 GB in it. The .dvc pointer files themselves are
# small, but they live under /data/, which is already ignored above.
.dvc/cache/
.dvc/tmp/

# A remote's credentials. `dvc remote modify --local` writes the token here in
# plain text, which is exactly why it is a separate file from .dvc/config —
# and exactly why it must never be committed. With git, `dvc init` would have
# written this ignore itself; with --no-scm it writes nothing, so it is here.
.dvc/config.local

# The DVC tooling lives in its own environment: dvc 3.x upgrades
# typing_extensions past the < 4.6 that TensorFlow 2.13 pins, so it must
# never share the training environment.
.venv-dvc/
